---
const { title, description = '醫學筆記、文獻閱讀與醫師國考練習。' } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
import '../styles/tokens.css';
import '../styles/tools.css';
---
<!doctype html>
<html lang="zh-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f7f2" />
    <title>{title}｜Medical Learning Hub</title>
  </head>
  <body>
    <header class="tool-header">
      <a class="brand" href={baseUrl}>Medical Learning Hub</a>
      <nav aria-label="主要導覽">
        <a href={baseUrl}>首頁</a><a href={`${baseUrl}medicine-3/`}>醫學筆記</a><a href={`${baseUrl}literature/`}>文獻閱讀</a><a href={`${baseUrl}practice/`}>國考練習</a><a href={`${baseUrl}calculators/`}>計算器</a><a href={`${baseUrl}tables/`}>表格</a>
      </nav>
      <button type="button" id="theme-toggle" aria-label="切換明暗主題">◐</button>
    </header>
    <slot />
    <footer class="tool-footer">Medical Learning Hub · 個人醫學學習工具 · 教育用途</footer>
    <script>
      const saved = localStorage.getItem('starlight-theme');
      if (saved === 'dark' || saved === 'light') document.documentElement.dataset.theme = saved;
      else document.documentElement.dataset.theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      document.querySelector('#theme-toggle').addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        if (next === 'dark') document.documentElement.dataset.theme = 'dark'; else delete document.documentElement.dataset.theme;
        localStorage.setItem('starlight-theme', next);
      });
    </script>
  </body>
</html>
