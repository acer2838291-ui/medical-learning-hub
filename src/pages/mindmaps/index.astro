---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="互動式心智圖" description="編輯、搜尋、儲存及匯出醫學知識心智圖。">
  <main class="tool-page mindmap-page"><p class="eyebrow">CONNECT · MIND MAP WORKSPACE</p><h1>互動式心智圖</h1>
    <p>選取節點查看說明；新增、編輯、刪除、展開分支並儲存到目前瀏覽器。可由急性腎損傷示範圖開始，再另存你的版本。</p>
    <div class="card-grid"><label>圖名<input id="map-title" value="急性腎損傷｜疾病概觀" /></label><label>圖型<select id="map-kind"><option value="disease-overview">Disease Overview</option><option value="pathophysiology-flow">Pathophysiology Flow</option><option value="differential-diagnosis">Differential Diagnosis</option><option value="diagnostic-algorithm">Diagnostic Algorithm</option><option value="treatment-algorithm">Treatment Algorithm</option><option value="drug-mechanism">Drug Mechanism</option></select></label><label>搜尋節點<input id="map-search" placeholder="搜尋標題或說明" /></label></div>
    <div class="card-grid"><button id="add-child" type="button">新增子節點</button><button id="edit-node" type="button">編輯選取節點</button><button id="delete-node" type="button">刪除選取節點與子分支</button><button id="toggle-branch" type="button">展開／收合選取分支</button><button id="zoom-out" type="button">−</button><button id="zoom-in" type="button">＋</button><button id="save-map" type="button">儲存心智圖</button><button id="export-json" type="button">匯出 JSON</button><label>匯入 JSON<input id="map-import" type="file" accept="application/json,.json" /></label><button id="export-svg" type="button">匯出 SVG</button></div>
    <div class="mindmap-wrap" id="mindmap-wrap"><svg id="mindmap-svg" role="img" aria-label="可互動的急性腎損傷心智圖"></svg></div>
    <div class="mindmap-columns"><section class="tool-card"><h2>節點說明</h2><div id="node-detail" aria-live="polite">選取一個節點查看說明。</div><p id="map-source" class="muted-note"></p></section><section class="tool-card"><h2>文字大綱</h2><nav id="mindmap-outline" aria-label="心智圖文字大綱"></nav></section></div>
    <h2>我的心智圖</h2><div id="saved-maps" class="card-grid"></div><output id="map-status" aria-live="polite"></output>
  </main>
  <script>
    import { allRecords, saveRecord, deleteRecord } from '../../lib/personal-db';
    const initialNodes = [
      { id: 'aki', conceptId: 'disease.aki', parentId: null, label: '急性腎損傷（AKI）', detail: '腎功能突然下降或喪失的臨床症候群；以肌酸酐與尿量隨時間變化作為常用判讀依據。', type: 'topic', diseaseUrl: '/medical-learning-hub/knowledge/aki/', collapsed: false, source: 'Turgut et al., Biomedicines 2023;11(1):80, CC BY 4.0', verification: 'source-checked' },
      { id: 'cause', parentId: 'aki', label: '病因分類', detail: '概念上分為腎前性、腎實質性與腎後性；病例常有多重因素，分類間也共享病理生理特徵。', type: 'cause', collapsed: false, source: 'Turgut et al. 2023, Abstract and Table 1', verification: 'source-checked' },
      { id: 'prerenal', parentId: 'cause', label: '腎前性：灌流不足', detail: '真實或有效循環血量下降可降低腎灌流；若低灌流持續或代償不足，可能進一步造成組織傷害。', type: 'mechanism', source: 'Turgut et al. 2023, section 1.2', verification: 'source-checked' },
      { id: 'intrinsic', parentId: 'cause', label: '腎實質：小管／間質／腎絲球／血管', detail: '缺血、感染、腎毒性暴露、自體免疫與腎血管疾病等可影響不同腎組織結構。', type: 'mechanism', source: 'Turgut et al. 2023, Table 1 and sections 3–5', verification: 'source-checked' },
      { id: 'postrenal', parentId: 'cause', label: '腎後性：尿路阻塞', detail: '結石、腫瘤壓迫、前列腺或膀胱問題等造成尿路阻塞；腎功能恢復受阻塞時間和嚴重度影響。', type: 'diagnosis', source: 'Turgut et al. 2023, section 5.4', verification: 'source-checked' },
      { id: 'manifestations', parentId: 'aki', label: '臨床表現', detail: 'AKI 可至較晚期才有明顯臨床表現；肌酸酐及尿量指標需隨時間解讀。', type: 'manifestation', source: 'Turgut et al. 2023, sections 1 and 6', verification: 'source-checked' },
      { id: 'diagnosis', parentId: 'aki', label: '診斷與評估', detail: '依據肌酸酐與尿量變化識別 AKI，結合病史、起始時間與身體檢查找尋病因。', type: 'diagnosis', source: 'Turgut et al. 2023; NIDDK USRDS 2018, Table A', verification: 'source-checked' },
      { id: 'labs', parentId: 'diagnosis', label: '腎功能指標：SCr、胱抑素 C、尿量', detail: '回顧指出上述指標需隨時間判讀，且單獨使用可能存在敏感度與特異度限制。', type: 'diagnosis', source: 'Turgut et al. 2023, section 1', verification: 'source-checked' },
      { id: 'imaging', parentId: 'diagnosis', label: '影像與阻塞排查', detail: '懷疑尿路阻塞時須安排適當影像評估；本示範不指定檢查效能或診斷門檻。', type: 'diagnosis', source: 'Turgut et al. 2023, section 5.4', verification: 'source-checked' },
      { id: 'management', parentId: 'aki', label: '治療與藥理', detail: '目前這份示範回顧沒有提供足以整理成治療指引的內容；需另核對具日期版本的臨床指引。', type: 'treatment', source: '', verification: 'unverified' },
      { id: 'dialysis', parentId: 'management', label: '治療決策：待查證', detail: '透析適應情境和啟動決策未在此來源中核對，保持空白待驗證。', type: 'treatment', source: '', verification: 'unverified' },
    ];
    let nodes = structuredClone(initialNodes); let selectedId = 'aki'; let zoom = 1; let pan = { x: 0, y: 0 };
    const svg = document.querySelector('#mindmap-svg'); const wrap = document.querySelector('#mindmap-wrap'); const detail = document.querySelector('#node-detail'); const status = document.querySelector('#map-status');
    const colors = { topic: '#829394', cause: '#b4a088', mechanism: '#a5684d', manifestation: '#5f738b', diagnosis: '#477663', treatment: '#bd7b63', reference: '#737a75', custom: '#9b886b' };
    const esc = (value) => String(value ?? '').replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char]);
    function visibleNodes() { const hidden = new Set(); const isHidden = (node) => { let parent = nodes.find((item) => item.id === node.parentId); while (parent) { if (parent.collapsed) return true; parent = nodes.find((item) => item.id === parent.parentId); } return false; }; return nodes.filter((node) => !isHidden(node)); }
    function descendants(id) { return nodes.filter((node) => node.parentId === id); }
    function layout() { const shown = visibleNodes(); const levels = new Map(); const ys = new Map(); let leaf = 0; const place = (node) => { const children = shown.filter((item) => item.parentId === node.id); if (!children.length) { ys.set(node.id, 100 + leaf++ * 125); } else { children.forEach(place); ys.set(node.id, children.reduce((sum, child) => sum + ys.get(child.id), 0) / children.length); } }; const root = nodes.find((node) => node.parentId === null); if (root) place(root); shown.forEach((node) => { let depth = 0; let parent = node; while (parent.parentId) { depth += 1; parent = nodes.find((item) => item.id === parent.parentId); } levels.set(node.id, depth); }); const height = Math.max(360, leaf * 125 + 100); const width = Math.max(900, (Math.max(...levels.values()) + 1) * 300 + 160); return { shown, ys, levels, width, height }; }
    function render() {
      const { shown, ys, levels, width, height } = layout();
      svg.setAttribute('viewBox', (pan.x) + ' ' + (pan.y) + ' ' + (width / zoom) + ' ' + (height / zoom)); svg.setAttribute('width', width); svg.setAttribute('height', height);
      const lines = shown.filter((node) => node.parentId).map((node) => { const parent = shown.find((item) => item.id === node.parentId); return parent ? '<path d="M ' + (150 + levels.get(parent.id) * 300) + ' ' + ys.get(parent.id) + ' C ' + (210 + levels.get(parent.id) * 300) + ' ' + ys.get(parent.id) + ', ' + (90 + levels.get(node.id) * 300) + ' ' + ys.get(node.id) + ', ' + (150 + levels.get(node.id) * 300) + ' ' + ys.get(node.id) + '" fill="none" stroke="var(--mlh-border)" stroke-width="2" />' : ''; }).join('');
      const boxes = shown.map((node) => { const x = 35 + levels.get(node.id) * 300; const y = ys.get(node.id) - 28; const label = node.label.length > 32 ? node.label.slice(0, 29) + '…' : node.label; return '<g tabindex="0" role="button" aria-label="' + esc(node.label) + '" data-node="' + esc(node.id) + '" class="map-node ' + (node.id === selectedId ? 'selected' : '') + '"><rect x="' + x + '" y="' + y + '" width="230" height="56" rx="9" fill="' + (colors[node.type] || colors.custom) + '" /><text x="' + (x + 14) + '" y="' + (y + 24) + '" fill="#fff" font-size="14" font-family="sans-serif">' + esc(label) + '</text><text x="' + (x + 14) + '" y="' + (y + 43) + '" fill="#fff" opacity=".86" font-size="10" font-family="sans-serif">' + esc(node.type) + (descendants(node.id).length ? (node.collapsed ? ' · 展開' : ' · 收合') : '') + '</text></g>'; }).join('');
      svg.innerHTML = '<rect width="100%" height="100%" fill="transparent" />' + lines + boxes;
      svg.querySelectorAll('[data-node]').forEach((group) => { group.addEventListener('click', () => selectNode(group.dataset.node)); group.addEventListener('keydown', (event) => { if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); selectNode(group.dataset.node); } }); });
      renderDetail(); renderOutline();
    }
    function selectNode(id) { selectedId = id; render(); }
    function renderDetail() { const node = nodes.find((item) => item.id === selectedId); if (!node) return; detail.innerHTML = '<h3>' + esc(node.label) + '</h3><p>' + esc(node.detail || '尚未填寫說明。') + '</p><p><span class="type-tag">' + esc(node.type) + '</span> · ' + esc(node.verification || 'unverified') + '</p>' + (node.diseaseUrl ? '<p><a href="' + esc(node.diseaseUrl) + '">開啟疾病知識頁</a></p>' : ''); document.querySelector('#map-source').textContent = node.source ? '來源定位：' + node.source : '來源尚未核對。'; }
    function renderOutline() { const list = document.querySelector('#mindmap-outline'); const branches = (parentId, depth) => nodes.filter((item) => item.parentId === parentId).map((node) => '<li style="margin-inline-start:' + (depth * 1.1) + 'rem"><button type="button" data-outline="' + esc(node.id) + '">' + esc(node.label) + '</button></li>' + (node.collapsed ? '' : branches(node.id, depth + 1))).join(''); const root = nodes.find((node) => node.parentId === null); list.innerHTML = root ? '<ul><li><button type="button" data-outline="' + esc(root.id) + '">' + esc(root.label) + '</button></li>' + (root.collapsed ? '' : branches(root.id, 1)) + '</ul>' : '<p>尚無節點。</p>'; list.querySelectorAll('[data-outline]').forEach((button) => button.addEventListener('click', () => selectNode(button.dataset.outline))); }
    function download(text, filename, type) { const url = URL.createObjectURL(new Blob([text], { type })); const link = document.createElement('a'); link.href = url; link.download = filename; link.click(); URL.revokeObjectURL(url); }
    document.querySelector('#add-child').addEventListener('click', () => { const id = crypto.randomUUID(); nodes.push({ id, parentId: selectedId, label: '新節點', detail: '', type: 'custom', collapsed: false, source: '', verification: 'unverified' }); const parent = nodes.find((node) => node.id === selectedId); if (parent) parent.collapsed = false; selectedId = id; render(); document.querySelector('#edit-node').click(); });
    document.querySelector('#edit-node').addEventListener('click', () => { const node = nodes.find((item) => item.id === selectedId); if (!node) return; const label = prompt('節點名稱', node.label); if (label === null) return; const detailText = prompt('節點說明', node.detail || '') ?? node.detail; const type = prompt('節點類型：topic、cause、mechanism、manifestation、diagnosis、treatment、reference、custom', node.type); if (type === null) return; const source = prompt('來源定位（URL／章節／頁碼）', node.source || '') ?? node.source; node.label = label.trim() || node.label; node.detail = detailText; node.type = ['topic','cause','mechanism','manifestation','diagnosis','treatment','reference','custom'].includes(type) ? type : 'custom'; node.source = source; node.verification = source ? 'source-checked' : 'unverified'; render(); });
    document.querySelector('#delete-node').addEventListener('click', () => { if (nodes.find((node) => node.id === selectedId)?.parentId === null) { status.textContent = '中心主題不可刪除。'; return; } const remove = new Set([selectedId]); let changed = true; while (changed) { changed = false; nodes.forEach((node) => { if (remove.has(node.parentId) && !remove.has(node.id)) { remove.add(node.id); changed = true; } }); } nodes = nodes.filter((node) => !remove.has(node.id)); selectedId = nodes[0]?.id; render(); });
    document.querySelector('#toggle-branch').addEventListener('click', () => { const node = nodes.find((item) => item.id === selectedId); if (node && descendants(node.id).length) { node.collapsed = !node.collapsed; render(); } });
    document.querySelector('#zoom-in').addEventListener('click', () => { zoom = Math.min(2.5, zoom + .2); render(); }); document.querySelector('#zoom-out').addEventListener('click', () => { zoom = Math.max(.55, zoom - .2); render(); });
    document.querySelector('#map-search').addEventListener('input', (event) => { const query = event.currentTarget.value.trim().toLocaleLowerCase(); if (!query) return; const found = nodes.find((node) => (node.label + ' ' + node.detail).toLocaleLowerCase().includes(query)); if (found) { let parent = nodes.find((node) => node.id === found.parentId); while (parent) { parent.collapsed = false; parent = nodes.find((node) => node.id === parent.parentId); } selectedId = found.id; render(); } });
    let drag = null; svg.addEventListener('pointerdown', (event) => { if (event.target.closest('[data-node]')) return; drag = { x: event.clientX, y: event.clientY, pan: { ...pan } }; svg.setPointerCapture(event.pointerId); }); svg.addEventListener('pointermove', (event) => { if (!drag) return; pan.x = drag.pan.x - (event.clientX - drag.x) / zoom; pan.y = drag.pan.y - (event.clientY - drag.y) / zoom; render(); }); svg.addEventListener('pointerup', () => { drag = null; });
    document.querySelector('#map-title').addEventListener('input', () => {});
    document.querySelector('#map-kind').addEventListener('change', () => {});
    document.querySelector('#save-map').addEventListener('click', async () => { const record = { id: crypto.randomUUID(), title: document.querySelector('#map-title').value, kind: document.querySelector('#map-kind').value, nodes, updatedAt: new Date().toISOString() }; await saveRecord('mindmaps', record); status.textContent = '心智圖已儲存在目前瀏覽器。'; renderSaved(); });
    document.querySelector('#export-json').addEventListener('click', () => download(JSON.stringify({ id: 'aki-overview', title: document.querySelector('#map-title').value, kind: document.querySelector('#map-kind').value, nodes, updatedAt: new Date().toISOString() }, null, 2), 'medical-mindmap.json', 'application/json'));
    document.querySelector('#map-import').addEventListener('change', async (event) => { try { const file = event.currentTarget.files[0]; if (!file) return; const map = JSON.parse(await file.text()); const ids = new Set((map.nodes || []).map((node) => node.id)); if (!Array.isArray(map.nodes) || !map.nodes.length || !map.nodes.every((node) => typeof node.id === 'string' && typeof node.label === 'string' && ['topic','cause','mechanism','manifestation','diagnosis','treatment','reference','custom'].includes(node.type) && (node.parentId === null || ids.has(node.parentId))) || map.nodes.filter((node) => node.parentId === null).length !== 1) throw new Error('心智圖節點、類型或父子關係不符合格式。'); const byId = new Map(map.nodes.map((node) => [node.id, node])); for (const node of map.nodes) { const seen = new Set([node.id]); let parentId = node.parentId; while (parentId !== null) { if (seen.has(parentId)) throw new Error('心智圖不可包含循環父子關係。'); seen.add(parentId); parentId = byId.get(parentId)?.parentId ?? null; } } nodes = map.nodes; selectedId = nodes.find((node) => node.parentId === null).id; document.querySelector('#map-title').value = String(map.title || '匯入的心智圖'); document.querySelector('#map-kind').value = ['disease-overview','pathophysiology-flow','differential-diagnosis','diagnostic-algorithm','treatment-algorithm','drug-mechanism'].includes(map.kind) ? map.kind : 'disease-overview'; pan = { x: 0, y: 0 }; zoom = 1; render(); status.textContent = '心智圖 JSON 已匯入；按儲存將加入本機資料庫。'; } catch (error) { status.textContent = '匯入失敗：' + error.message; } });
    document.querySelector('#export-svg').addEventListener('click', () => { const copy = svg.cloneNode(true); copy.setAttribute('xmlns', 'http://www.w3.org/2000/svg'); copy.setAttribute('viewBox', '0 0 ' + svg.getAttribute('width') + ' ' + svg.getAttribute('height')); download(new XMLSerializer().serializeToString(copy), 'medical-mindmap.svg', 'image/svg+xml'); });
    async function renderSaved() { const maps = await allRecords('mindmaps'); const list = document.querySelector('#saved-maps'); list.replaceChildren(); if (!maps.length) { list.innerHTML = '<p class="empty-state">尚無保存的心智圖。</p>'; return; } for (const map of maps) { const card = document.createElement('article'); card.className = 'tool-card'; card.innerHTML = '<h3>' + esc(map.title) + '</h3><p>' + esc(map.kind) + ' · ' + (map.nodes || []).length + ' 個節點</p><button type="button" data-open="' + esc(map.id) + '">載入</button> <button type="button" data-delete="' + esc(map.id) + '">刪除</button>'; list.append(card); } list.querySelectorAll('[data-open]').forEach((button) => button.addEventListener('click', async () => { const map = (await allRecords('mindmaps')).find((item) => item.id === button.dataset.open); nodes = map.nodes; selectedId = nodes[0]?.id; document.querySelector('#map-title').value = map.title; document.querySelector('#map-kind').value = map.kind; pan = { x: 0, y: 0 }; zoom = 1; render(); status.textContent = '心智圖已重新載入。'; })); list.querySelectorAll('[data-delete]').forEach((button) => button.addEventListener('click', async () => { await deleteRecord('mindmaps', button.dataset.delete); renderSaved(); })); }
    render(); renderSaved();
  </script>
</BaseLayout>
